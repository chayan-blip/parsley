flowchart TB
    %% ===== Celery Application Core =====
    subgraph CORE["Celery Application Core — celery/app/"]
        direction TB

        CELERY["base.py : Celery\n(application facade · 186 edges, core god node)"]

        subgraph FACET["Facade accessors → subsystems"]
            F_AMQP["amqp property → app/amqp.py"]
            F_TASKS["tasks property → app/registry.py"]
            F_CONTROL["control → app/control.py"]
            F_EVENTS["events → app/events.py"]
            F_LOG["log → app/log.py"]
            F_BACKEND["_get_backend() → app/backends.py"]
            F_BEAT["Beat → app/beat.py (workflow)"]
        end

        TASK["task.py : Task base class\n(+ Context, Request traits)"]
        REGISTRY["registry.py : TaskRegistry\n+ shared_task(), task() decorator"]
        AMQP["amqp.py : queues, routing,\nexchanges, connections"]
        CONTROL["control.py : worker\nremote-control commands"]
        EVENTS["events.py : event\ndispatcher / receiver"]
        LOG["log.py : logging setup\n+ TaskFormatter"]
        ANNOT["annotations.py : task\nannotation / stamping"]
        AUTORETRY["autoretry.py :\nclass-based auto-retry"]
        DEFAULTS["defaults.py :\nconfig defaults"]
        UTILS["utils.py : app helpers\n(gen_task_name, settings, etc.)"]
        ROUTES["routes.py : task\nrouting policy"]
        BUILTINS["builtins.py : built-in\ntasks (debug, ping)"]
    end

    %% Intra-app imports (ground truth)
    CELERY --> F_AMQP
    CELERY --> F_TASKS
    CELERY --> F_CONTROL
    CELERY --> F_EVENTS
    CELERY --> F_LOG
    CELERY --> F_BACKEND
    CELERY --> F_BEAT

    TASK --> ANNOT
    TASK --> REGISTRY
    TASK --> UTILS
    REGISTRY --> AUTORETRY
    AMQP --> DEFAULTS
    CELERY --> DEFAULTS
    CELERY --> UTILS
    UTILS --> DEFAULTS
    UTILS --> CELERY
    BUILTINS --> REGISTRY

    %% ==== External subsystems the facade wires together ====
    subgraph BROKER["Broker & Messaging"]
        CONN["connection + producer pool\n(celery.app.amqp → kombu)"]
        MEDIA["kombu: Queue, Exchange,\nProducer, Consumer"]
    end
    F_AMQP --> CONN
    CONN --> MEDIA

    subgraph WORKER["Worker execution"]
        WORKCTL["WorkController / Worker\n(celery.worker)"]
        BOOTSTEPS["bootsteps\n(consumer control panel)"]
    end
    F_BEAT --> WORKCTL

    subgraph BEAT["Scheduler"]
        SCHED["celery.beat : Beat /\nScheduler, ScheduleEntry"]
    end
    F_BEAT --> SCHED

    subgraph RESULTB["Result Backends"]
        RESBACKEND["celery.backends.base : Backend"]
        RESBACKEND_IMPL["RPC / redis / db / cache /\nazure / gcs / arangodb ..."]
        ASYNCRESULT["result.py : AsyncResult,\nResultSet via Celery.AsyncResult()"]
    end
    F_BACKEND --> RESBACKEND
    RESBACKEND --> RESBACKEND_IMPL
    CELERY --> ASYNCRESULT

    subgraph TASKRUN["Task runtime / tracing"]
        TRACE["celery.app.trace : trace_task,\nbuild_tracer (fast_trace_task)"]
        REQUEST["request : TaskRequest\n(eager + protocol v2)"]
    end
    TRACE --> TASK
    F_TASKS --> TASK

    %% ===== Canvas + public API =====
    subgraph API["Public API / canvas"]
        CANVAS["celery.canvas : Signature,\ngroup, chain, chord, chunks"]
        PUI["celery/__init__.py :\nCelery(), shared_task(),\ntask(), current_app"]
    end
    CANVAS --> F_TASKS
    PUI --> CELERY
    TRACE --> CANVAS
